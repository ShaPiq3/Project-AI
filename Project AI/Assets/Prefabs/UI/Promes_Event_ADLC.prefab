  m_text: "\uB300\uAD6D\uC740 5\uAD6D \uBAA8\uB450 \uCDA9\uACA9\uC801\uC778 \uACB0\uACFC\uB85C
    \uB9C8\uBB34\uB9AC\uB418\uC5C8\uB2E4. \uBE44\uB85D \uB300\uAD6D \uC9C4\uD589
    \uB2F9\uC2DC \uC138\uACC4 \uCC54\uD53C\uC5B8\uC740 \uC544\uB2C8\uC5C8\uC9C0\uB9CC,
