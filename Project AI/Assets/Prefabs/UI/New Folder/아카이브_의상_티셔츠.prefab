    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uC2EC \uB300\uD45C\uB294 \uBCF8\uC778\uC758 \uC778\uB9DD\uACFC \uD2B9\uD5C8
        \uB9E4\uAC01, \uC2EC\uC9C0\uC5B4 \uB2F4\uBCF4\uB300\uCD9C\uAE4C\uC9C0 \uB3D9\uC6D0\uD574
        \uC790\uAE08\uC744 \uCDA9\uB2F9\uD588\uC9C0\uB9CC, \uC774\uC6A9\uC790 \uC720\uCE58\uB97C
        \uC704\uD574 \uB2E4\uC591\uD55C \uC11C\uBE44\uC2A4\uB4E4\uC744 \uCD94\uAC00
        \uD560 \uC218\uB85D \uC720\uC9C0\uBE44\uAC00 \uB298\uC5B4\uB098 \uD30C\uC0B0
        \uC704\uAE30\uC5D0 \uBAB0\uB838\uB2E4. \uC2EC \uB300\uD45C\uAC00 \uC9C1\uC6D0\uB4E4\uC5D0\uAC8C
        \uC0AC\uBE44\uB85C \uC6D4\uAE09\uC744 \uC9C0\uAE09\uD558\uAC70\uB098 \uC784\uAE08\uC774
        \uCCB4\uBD88\uB41C \uACBD\uC6B0\uB3C4 \uC7A6\uC558\uB2E4\uACE0 \uD55C\uB2E4. "
