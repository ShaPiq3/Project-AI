    - target: {fileID: 5255810921066210438, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uD2F0\uC154\uCE20\uB294 \uBAB8\uD1B5\uACFC \uC18C\uB9E4\uAC00 \uC54C\uD30C\uBCB3
        T\uC640 \uBE44\uC2B7\uD55C \uD615\uD0DC\uB97C \uC774\uB8E8\uB294 \uC0C1\uC758\uB85C,
        \uC77C\uBC18\uC801\uC73C\uB85C \uCE7C\uB77C\uC640 \uC55E\uC5EC\uBC08\uC774
        \uC5C6\uB2E4. \uC8FC\uB85C \uBA74\uC774\uB098 \uC2E0\uCD95\uC131 \uC788\uB294
        \uB2C8\uD2B8 \uC6D0\uB2E8\uC73C\uB85C \uC81C\uC791\uB418\uBA70, \uBAA9 \uBAA8\uC591\uACFC
        \uC18C\uB9E4 \uAE38\uC774, \uCC29\uC6A9\uAC10\uC5D0 \uB530\uB77C \uC5EC\uB7EC
        \uC885\uB958\uB85C \uB098\uB25C\uB2E4."
