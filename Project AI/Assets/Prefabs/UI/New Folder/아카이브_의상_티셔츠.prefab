    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uBCF8\uB798 19\uC138\uAE30 \uB9D0\uBD80\uD130 20\uC138\uAE30 \uCD08
        \uC0AC\uC774 \uC18D\uC637\uC774\uB098 \uAD70\uC6A9 \uB0B4\uC758\uB85C \uC0AC\uC6A9\uB418\uC5C8\uC73C\uB098,
        \uC774\uD6C4 \uC2A4\uD3EC\uCE20\uC6E8\uC5B4\uC640 \uB300\uC911\uBB38\uD654\uC758
        \uD655\uC0B0\uC744 \uAC70\uCE58\uBA70 \uB3C5\uB9BD\uC801\uC778 \uAC89\uC637\uC73C\uB85C
        \uC815\uCC29\uD558\uC600\uB2E4. \uC81C\uC791\uC774 \uBE44\uAD50\uC801 \uAC04\uB2E8\uD558\uACE0
        \uC138\uD0C1\uACFC \uAD00\uB9AC\uAC00 \uC26C\uC6CC \uC77C\uC0C1\uBCF5, \uC791\uC5C5\uBCF5,
        \uC6B4\uB3D9\uBCF5, \uC7A0\uC637 \uB4F1 \uB2E4\uC591\uD55C \uC6A9\uB3C4\uB85C
        \uB110\uB9AC \uCC29\uC6A9\uB41C\uB2E4."
