    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "\uC5ED\uC0AC\uC801\uC73C\uB85C\uB294 \uC9C0\uC5ED\uACFC \uC2DC\uB300\uC5D0
        \uB530\uB77C \uAE34 \uAC89\uC637\uC774\uB098 \uC5EC\uC131\uC6A9 \uC608\uBCF5\uC758
        \uD615\uD0DC\uB85C \uBC1C\uC804\uD588\uC73C\uBA70, \uADFC\uB300 \uC774\uD6C4
        \uAE30\uC131\uBCF5 \uC0B0\uC5C5\uC758 \uC131\uC7A5\uACFC \uD568\uAED8 \uB300\uD45C\uC801\uC778
        \uC5EC\uC131\uBCF5 \uD488\uBAA9\uC73C\uB85C \uC790\uB9AC \uC7A1\uC558\uB2E4.
        \uC624\uB298\uB0A0\uC5D0\uB294 \uC131\uBCC4\uC5D0 \uD55C\uC815\uB418\uC9C0
        \uC54A\uB294 \uD328\uC158 \uC544\uC774\uD15C\uC73C\uB85C\uB3C4 \uD65C\uC6A9\uB41C\uB2E4.
        \uB514\uC790\uC778\uC5D0 \uB530\uB77C \uD5C8\uB9AC\uC120\uC744 \uAC15\uC870\uD558\uAC70\uB098
        \uBAB8\uC758 \uC120\uC744 \uB290\uC2A8\uD558\uAC8C \uAC10\uC2F8\uB294 \uB4F1
        \uC778\uC0C1\uC774 \uB2EC\uB77C\uC9C0\uBA70, \uC561\uC138\uC11C\uB9AC\uC640
        \uAC89\uC637\uC744 \uB354\uD574 \uACA9\uC2DD\uACFC \uBD84\uC704\uAE30\uB97C
        \uC870\uC808\uD558\uAE30\uB3C4 \uD55C\uB2E4. "
      objectReference: {fileID: 0}
