    - target: {fileID: 5255810921066210438, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "\uC6D0\uD53C\uC2A4\uB294 \uC0C1\uC758\uC640 \uCE58\uB9C8\uAC00 \uD558\uB098\uB85C
        \uC774\uC5B4\uC9C4 \uD615\uD0DC\uC758 \uC758\uBCF5\uC73C\uB85C, \uC601\uC5B4\uAD8C\uC5D0\uC11C\uB294
        \uC8FC\uB85C \uB4DC\uB808\uC2A4\uB77C \uBD80\uB978\uB2E4. \uD55C \uBC8C\uB9CC\uC73C\uB85C
        \uBCF5\uC7A5\uC774 \uC644\uC131\uB418\uC5B4 \uCC29\uC6A9\uC774 \uAC04\uD3B8\uD558\uBA70,
        \uBAA9\uC120/\uC18C\uB9E4/\uD5C8\uB9AC\uC120/\uCE58\uB9C8 \uAE38\uC774\uC640
        \uC2E4\uB8E8\uC5E3\uC5D0 \uB530\uB77C \uB2E4\uC591\uD55C \uD615\uD0DC\uB85C
        \uB098\uB25C\uB2E4. \uC154\uCE20 \uC6D0\uD53C\uC2A4, \uB7A9 \uC6D0\uD53C\uC2A4,
        A\uB77C\uC778 \uC6D0\uD53C\uC2A4 \uB4F1\uC774 \uB300\uD45C\uC801\uC774\uBA70,
        \uC77C\uC0C1\uBCF5\uBD80\uD130 \uC0AC\uBB34\uBCF5/\uC608\uBCF5/\uBB34\uB300
        \uC758\uC0C1\uAE4C\uC9C0 \uD3ED\uB113\uAC8C \uC0AC\uC6A9\uB41C\uB2E4. "
      objectReference: {fileID: 0}
