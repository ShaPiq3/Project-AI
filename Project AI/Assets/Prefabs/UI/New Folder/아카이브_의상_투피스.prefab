    - target: {fileID: 5255810921066210438, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uD22C\uD53C\uC2A4\uB294 \uC0C1\uC758\uC640 \uD558\uC758\uAC00 \uBD84\uB9AC\uB418\uC5B4
        \uC788\uC73C\uBA74\uC11C \uD558\uB098\uC758 \uBCF5\uC7A5\uC73C\uB85C \uAD6C\uC131\uB41C
        \uB450 \uBC8C\uC9DC\uB9AC \uC758\uBCF5\uC774\uB2E4. \uC7AC\uD0B7\uACFC \uCE58\uB9C8,
        \uC7AC\uD0B7\uACFC \uBC14\uC9C0, \uBE14\uB77C\uC6B0\uC2A4\uC640 \uCE58\uB9C8
        \uB4F1\uC758 \uC870\uD569\uC774 \uB300\uD45C\uC801\uC774\uBA70, \uAC19\uC740
        \uC18C\uC7AC\uB098 \uC0C9\uC0C1, \uB514\uC790\uC778\uC744 \uC0AC\uC6A9\uD574
        \uD1B5\uC77C\uAC10\uC744 \uC900\uB2E4. \uAC01 \uC758\uB958\uB97C \uB530\uB85C
        \uCC29\uC6A9\uD560 \uC218\uB3C4 \uC788\uC5B4 \uD65C\uC6A9\uB3C4\uAC00 \uB192\uC73C\uBA70,
        \uC815\uC7A5/\uC0AC\uBB34\uBCF5/\uAD50\uBCF5/\uC77C\uC0C1\uBCF5 \uB4F1\uC5D0
        \uB110\uB9AC \uC4F0\uC778\uB2E4. \uB0A8\uC131\uBCF5\uC758 \uC288\uD2B8 \uC5ED\uC2DC
        \uB113\uC740 \uC758\uBBF8\uC5D0\uC11C\uB294 \uD22C\uD53C\uC2A4 \uAD6C\uC131\uC73C\uB85C
        \uBCFC \uC218 \uC788\uB2E4. "
      objectReference: {fileID: 0}
