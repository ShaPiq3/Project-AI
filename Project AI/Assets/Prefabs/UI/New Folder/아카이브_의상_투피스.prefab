    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  20\uC138\uAE30 \uC774\uD6C4 \uC5EC\uC131\uC758 \uC0AC\uD68C \uD65C\uB3D9
        \uC99D\uAC00\uC640 \uD568\uAED8 \uD65C\uB3D9\uC131\uACFC \uB2E8\uC815\uD568\uC744
        \uACB8\uBE44\uD55C \uBCF5\uC7A5\uC73C\uB85C \uBCF4\uAE09\uB418\uC5C8\uC73C\uBA70,
        \uD604\uB300\uC5D0\uB294 \uD06C\uB86D\uD2B8 \uC7AC\uD0B7\uACFC \uCE58\uB9C8,
        \uB2C8\uD2B8 \uC0C1\uD558\uC758\uCC98\uB7FC \uCE90\uC8FC\uC5BC\uD55C \uC138\uD2B8\uC5C5\uB3C4
        \uD22C\uD53C\uC2A4\uC758 \uBC94\uC8FC\uC5D0 \uD3EC\uD568\uB41C\uB2E4. \uC804\uD1B5\uC801\uC73C\uB85C\uB294
        \uC0C1\uD558\uC758\uB97C \uAC19\uC740 \uC6D0\uB2E8\uC73C\uB85C \uB9DE\uCD94\uC9C0\uB9CC,
        \uCD5C\uADFC\uC5D0\uB294 \uC0C9\uC0C1\uC774\uB098 \uC7AC\uC9C8\uC5D0 \uCC28\uC774\uB97C
        \uB450\uBA74\uC11C\uB3C4 \uACF5\uD1B5\uB41C \uB514\uC790\uC778 \uC694\uC18C\uB97C
        \uC801\uC6A9\uD558\uB294 \uACBD\uC6B0\uAC00 \uB9CE\uB2E4. "
      objectReference: {fileID: 0}
