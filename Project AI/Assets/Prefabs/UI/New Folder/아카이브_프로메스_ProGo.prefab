    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uAC00\uC7A5 \uC720\uBA85\uD55C \uB300\uAD6D\uC73C\uB85C\uB294 2016\uB144
        \uC9C4\uD589\uB41C \uC774\uC11D 9\uB2E8\uACFC\uC758 \uC544\uD2F0\uD53C\uC15C
        \uB525\uB7EC\uB2DD \uCC4C\uB9B0\uC9C0 \uB9E4\uCE58\uC774\uBA70, \u2018ProGo
        \uC1FC\uD06C\u2019 \uB77C\uACE0 \uBD88\uB9B4 \uB9CC\uD07C \uBC14\uB451\uACC4\uC640
        \uC778\uACF5\uC9C0\uB2A5\uACC4 \uBAA8\uB450\uC5D0\uAC8C \uD070 \uC601\uD5A5\uC744
        \uBBF8\uCE5C \uB300\uAD6D\uC774\uC5C8\uB2E4. \uC774 \uB300\uAD6D \uC774\uD6C4
        \uB300\uD55C\uAE30\uC6D0\uC774 ProGo\uC5D0\uAC8C \uBA85\uC608 9\uB2E8 \uB2E8\uC99D\uC744
        \uC218\uC5EC\uD558\uC5EC ProGo 9\uB2E8\uC774 \uB418\uC5C8\uB2E4."
      objectReference: {fileID: 0}
