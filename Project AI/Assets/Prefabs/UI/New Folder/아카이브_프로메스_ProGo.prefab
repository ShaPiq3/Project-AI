    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  GPU\uB97C \uC0AC\uC6A9\uD558\uB294 \uB525\uB7EC\uB2DD \uAE30\uBC18
        \uBC14\uB451 \uC778\uACF5\uC9C0\uB2A5\uC774\uBA70, \uC790\uAE30 \uC790\uC2E0\uACFC\uC758
        \uB300\uAD6D\uACFC \uD504\uB85C \uAE30\uC0AC\uB4E4\uC758 \uAE30\uBCF4 \uB370\uC774\uD130
        \uBD84\uC11D\uC744 \uD1B5\uD574 \uC131\uC7A5\uD588\uB2E4. \uCD08\uAE30 \uBC84\uC804\uC5D0\uC11C\uB294
        \uD504\uB85C \uAE30\uC0AC\uB4E4\uC5D0\uAC8C \uC2E4\uB825\uC801\uC73C\uB85C
        \uBC00\uB9AC\uB294 \uC591\uC0C1\uC744 \uBCF4\uC600\uC73C\uB098, \uC624\uB79C
        \uAE30\uAC04\uC758 \uB525\uB7EC\uB2DD\uC744 \uD1B5\uD574 \uC131\uB2A5\uC774
        \uC5B4\uB290 \uC815\uB3C4 \uC815\uB9BD\uB41C \uC774\uD6C4\uC5D0\uB294 \uADF8
        \uC5B4\uB5A4 \uC778\uAC04 \uD504\uB85C \uAE30\uC0AC\uB3C4 ProGo\uB97C \uC0C1\uB300\uB85C
        \uC2B9\uB9AC\uD558\uC9C0 \uBABB\uD588\uB2E4."
      objectReference: {fileID: 0}
