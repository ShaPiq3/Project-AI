    - target: {fileID: 5255810921066210438, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  ProGo\uB294 \uC544\uD2F0\uD53C\uC15C\uC5D0\uC11C \uAC1C\uBC1C\uD55C
        \uBC14\uB451 \uC778\uACF5\uC9C0\uB2A5\uC774\uB2E4. \uC778\uAC04 \uD504\uB85C
        \uBC14\uB451 \uAE30\uC0AC\uB97C \uC0C1\uB300\uB85C \uC2B9\uB9AC\uD55C \uCD5C\uCD08\uC758
        \uD504\uB85C\uADF8\uB7A8\uC774\uBA70, \uBC14\uB451\uC740 \uBB3C\uB860 \uC778\uACF5\uC9C0\uB2A5
        \uC5F0\uAD6C\uAC1C\uBC1C\uC758 \uD328\uB7EC\uB2E4\uC784\uC744 \uC644\uC804\uD788
        \uBC14\uAFD4\uBC84\uB9B0 \uC778\uACF5\uC9C0\uB2A5\uC774\uAE30\uB3C4 \uD558\uB2E4. "
