    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uCE58\uB9C8\uB294 \uC138\uACC4 \uC5EC\uB7EC \uBB38\uD654\uAD8C\uC5D0\uC11C
        \uC624\uB798\uC804\uBD80\uD130 \uCC29\uC6A9\uB418\uC5B4 \uC654\uC73C\uBA70
        \uBC18\uB4DC\uC2DC \uC5EC\uC131\uBCF5\uC5D0\uB9CC \uD55C\uC815\uB418\uC9C0
        \uC54A\uB294\uB2E4. \uD55C\uAD6D\uC758 \uD55C\uBCF5 \uCE58\uB9C8, \uC2A4\uCF54\uD2C0\uB79C\uB4DC\uC758
        \uD0AC\uD2B8, \uB0A8\uC544\uC2DC\uC544\uC640 \uB3D9\uB0A8\uC544\uC2DC\uC544\uC758
        \uC0AC\uB871\uCC98\uB7FC \uC9C0\uC5ED\uBCC4\uB85C \uC11C\uB85C \uB2E4\uB978
        \uD615\uD0DC\uC640 \uC758\uBBF8\uB97C \uC9C0\uB2CC \uC0AC\uB840\uAC00 \uC788\uB2E4.
        \uADFC\uB300 \uC11C\uC591 \uBCF5\uC2DD\uC5D0\uC11C\uB294 \uC5EC\uC131\uBCF5\uC758
        \uB300\uD45C\uC801\uC778 \uD558\uC758\uB85C \uC790\uB9AC \uC7A1\uC558\uACE0,
        \uD604\uB300\uC5D0\uB294 \uAD50\uBCF5\xB7\uC815\uC7A5\xB7\uC608\uBCF5\xB7\uC77C\uC0C1\uBCF5
        \uB4F1 \uD3ED\uB113\uC740 \uC6A9\uB3C4\uB85C \uC0AC\uC6A9\uB41C\uB2E4."
      objectReference: {fileID: 0}
