--- !u!114 &1841733438
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1841733434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  \uAC10\uC815 \uC131\uC0AC\uC728\uC774 10%\uB300\uC5D0 \uADF8\uCE5C \uC0C1\uB300\uC640
    \uACB0\uD63C\uC744 \uCD94\uC9C4\uD55C \uB0A8\uC131\uC758 \uC0AC\uB840\uAC00 \uC54C\uB824\uC84C\uB2E4.\r\n\r\n 
    \uC9C0\uB09C 16\uC77C\uACB0\uD63C \uB9E4\uCE6D \uC560\uD50C\uB9AC\uCF00\uC774\uC158
    \uD398\uC5B4\uB9C1\uD06C(PairLink) \uD68C\uC6D0 A\uC528\uB294 \uC5EC\uC131 \uD68C\uC6D0
    B\uC528\uC640\uC758 \uAC10\uC815 \uC131\uC0AC\uC728\uC774 10% \uB0A8\uC9D3\uC73C\uB85C
    \uCE21\uC815\uB410\uC74C\uC5D0\uB3C4 \uBCC4\uB3C4\uB85C \uC5F0\uB77D\uD574 \uB9CC\uB0A8\uC744
    \uC774\uC5B4\uAC14\uB2E4.\r\n\r\n  A\uC528\uB294 B\uC528\uAC00 \u201C\uBCF8\uC778\uC5D0\uAC8C
    \uC798 \uB9DE\uC744 \uAC83 \uAC19\uB2E4\u201D\uB294 \uC774\uC720\uB85C \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC758
    \uCD94\uCC9C \uACB0\uACFC\uB97C \uB530\uB974\uC9C0 \uC54A\uC740 \uAC83\uC73C\uB85C
    \uC804\uD574\uC84C\uB2E4. \uC774\uD6C4 \uB450 \uC0AC\uB78C\uC740 \uC571\uC744
    \uD0C8\uD1F4\uD558\uACE0 \uAC1C\uBCC4\uC801\uC73C\uB85C \uAD50\uC81C\uB97C \uC774\uC5B4\uAC14\uB2E4.\r\n\r\n 
    \uC774\uB4E4\uC740 \uC591\uAC00 \uBD80\uBAA8\uC5D0\uAC8C \uC11C\uB85C\uB97C \uC18C\uAC1C\uD558\uB294
    \uACFC\uC815\uC5D0\uC11C \uC2E4\uC81C \uAC10\uC815 \uC131\uC0AC\uC728\uC744 \uC228\uAE30\uACE0,
    \uC218\uCE58\uAC00 \uB192\uAC8C \uD45C\uC2DC\uB41C \uD654\uBA74\uC744 \uC870\uC791\uD574
    \uC804\uB2EC\uD55C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uB2E4.\r\n\r\n  \uC591\uAC00
    \uBD80\uBAA8\uB294 \uD574\uB2F9 \uC790\uB8CC\uB97C \uBC14\uD0D5\uC73C\uB85C \uB9CC\uB0A8\uC744
    \uD5C8\uB77D\uD588\uC73C\uB098, \uC774\uD6C4 \uC2E4\uC81C \uAE30\uB85D\uACFC
    \uB2E4\uB978 \uC0AC\uC2E4\uC774 \uD655\uC778\uB418\uBA70 \uBB38\uC81C\uAC00 \uBD88\uAC70\uC84C\uB2E4.\r\n\r\n 
    A\uC528 \uAC00\uC871\uC740 \u201C\uAC10\uC815 \uC131\uC0AC\uC728\uC774 \uB0AE\uC740
    \uAD00\uACC4\uC778 \uC904 \uC54C\uC558\uB2E4\uBA74 \uB9CC\uB0A8\uC744 \uD5C8\uB77D\uD558\uAE30
    \uC5B4\uB824\uC6E0\uC744 \uAC83\u201D\uC774\uB77C\uBA70 \u201C\uACB0\uD63C\uCC98\uB7FC
    \uC911\uC694\uD55C \uD310\uB2E8\uC5D0\uC11C \uAC80\uC99D \uC218\uCE58\uB97C \uC228\uAE34
    \uAC83\uC740 \uBC1B\uC544\uB4E4\uC774\uAE30 \uC5B4\uB835\uB2E4\u201D\uACE0 \uBC1D\uD614\uB2E4.\r\n\r\n 
    \uD55C\uAD6D\uAD00\uACC4\uC5F0\uAD6C\uC18C \uAD00\uACC4\uC790\uB294 \u201C\uAC10\uC815
    \uC131\uC0AC\uC728\uC740 \uB2E8\uC21C\uD55C \uD638\uAC10 \uC9C0\uD45C\uAC00 \uC544\uB2C8\uB77C
    \uC7A5\uAE30 \uAD00\uACC4 \uC801\uD569\uB3C4\uB97C \uC885\uD569\uD55C \uACB0\uACFC\u201D\uB77C\uBA70
    \u201C\uB0AE\uC740 \uC218\uCE58\uB97C \uC784\uC758\uB85C \uBB34\uC2DC\uD558\uAC70\uB098
    \uC870\uC791\uD558\uB294 \uAC83\uC740 \uAC00\uC871 \uAC04 \uC2E0\uB8B0 \uBB38\uC81C\uB85C
    \uC774\uC5B4\uC9C8 \uC218 \uC788\uB2E4\u201D\uACE0 \uB9D0\uD588\uB2E4.\r\n\r\n 
    \uD604\uC7AC \uB450 \uC0AC\uB78C\uC740 \uACB0\uD63C \uC758\uC0AC\uB97C \uC720\uC9C0\uD558\uACE0
    \uC788\uC73C\uB098, \uC591\uAC00 \uAC00\uC871\uC740 \uC7AC\uCE21\uC815 \uC808\uCC28\uB97C
    \uC694\uAD6C\uD55C \uAC83\uC73C\uB85C \uC804\uD574\uC84C\uB2E4."
