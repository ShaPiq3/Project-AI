    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  2016\uB144 \uC544\uD2F0\uD53C\uC15C\uC774 \uAC1C\uBC1C\uD55C \uBC14\uB451
        \uC778\uACF5\uC9C0\uB2A5\uC778 ProGo\uB97C \uC0C1\uB300\uB85C \uD55C \uC544\uD2F0\uD53C\uC15C
        \uB525\uB7EC\uB2DD \uCC4C\uB9B0\uC9C0 \uB9E4\uCE58\uC5D0\uC11C ProGo\uC5D0\uAC8C
        0\uB300 5\uB85C \uC644\uD328\uD558\uC600\uACE0, \uC774\uD6C4 \uD504\uB85C
        \uAE30\uC0AC \uC740\uD1F4\uB97C \uC120\uC5B8\uD588\uB2E4. "
