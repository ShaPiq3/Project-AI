    \uBCC0\uACBD\uD558\uACE0 LLM \uC5B8\uC5B4 \uBAA8\uB378 \uC778\uACF5\uC9C0\uB2A5\uC778
    PGT(PM-002)\uB97C \uACF5\uAC1C\uD558\uC600\uB2E4. \uAE30\uC874 AI\uC640\uB294
    \uBE44\uAD50\uB3C4 \uC548\uB418\uB294 \uACBD\uC545\uC2A4\uB7EC\uC6B4 \uC790\uC5F0\uC5B4
    \uCC98\uB9AC \uC131\uB2A5\uC5D0 \uC778\uACF5\uC9C0\uB2A5 \uC5C5\uACC4\uB294 'PGT
    \uC1FC\uD06C'\uB97C \uB9DE\uC774\uD558\uAC8C \uB41C\uB2E4.\n  \uC774\uC5B4\uC11C
    \uD504\uB85C\uBA54\uC2A4\uB294 Plaude(PM-0011), Prok(PM-0036)\uC744 \uC5F0\uB2EC\uC544
    \uCD9C\uC2DC\uD558\uBA70 \uC5B8\uC5B4 \uBAA8\uB378 \uC778\uACF5\uC9C0\uB2A5 \uC2DC\uC7A5\uC744
    \uB3C5\uC810\uD558\uC600\uACE0, \uC138\uACC4 \uCD5C\uB300 \uADDC\uBAA8\uC758
    AI \uB300\uAE30\uC5C5\uC73C\uB85C \uAE09\uC18D \uC131\uC7A5\uD558\uC600\uB2E4."
  m_isRightToLeft: 0
