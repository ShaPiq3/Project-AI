    - target: {fileID: 6693930765565681024, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
      propertyPath: m_text
      value: "\uC0AC\uC6A9 \uC911\uC778 \uAC1C\uBC1C \uD658\uACBD\uC758 \uBC84\uC804\uC744
        \uC81C\uB300\uB85C \uC54C\uB824\uC8FC\uC9C0 \uC54A\uC790 \uB354 \uCD5C\uC2E0
        \uBC84\uC804\uC758 \uAE30\uB2A5\uC744 \uC0AC\uC6A9\uD55C \uCF54\uB4DC\uB97C
        \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uD658\uACBD \uC870\uAC74\uC744 \uBA3C\uC800
        \uD655\uC778\uD558\uB294 \uACFC\uC815\uC774 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
