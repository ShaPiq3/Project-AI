  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=30><b>1. \uCC3D\uC5C5\uACFC \uAC80\uC0C9 \uC5D4\uC9C4 \uC2DC\uC7A5
    \uC7A5\uC545</b></size>\r\n  \uD504\uB85C\uBA54\uC2A4\uB294 1998\uB144 \uAC80\uC0C9
    \uC5D4\uC9C4 \uC11C\uBE44\uC2A4\uB85C \uCD9C\uBC1C\uD588\uB2E4. \uAC80\uC0C9
    \uC815\uD655\uB3C4\uC640 \uAC1C\uC778\uD654 \uCD94\uCC9C \uAE30\uB2A5\uC744 \uBC14\uD0D5\uC73C\uB85C
    \uC774\uC6A9\uC790\uB97C \uBE60\uB974\uAC8C \uD655\uBCF4\uD588\uC73C\uBA70, 2005\uB144
    \uC804 \uC138\uACC4 \uAC80\uC0C9 \uC5D4\uC9C4 \uC810\uC720\uC728 92%\uB97C \uB2EC\uC131\uD588\uB2E4.
    2006\uB144\uC5D0\uB294 AASDAQ\uC5D0 \uC0C1\uC7A5\uD558\uACE0 \uC778\uD130\uB137
    \uC11C\uBE44\uC2A4 \uC804\uBC18\uC73C\uB85C \uC0AC\uC5C5\uC744 \uD655\uC7A5\uD558\uC600\uB2E4.\r\n\r\n\r\n<size=30><b>2.
    IGNIS \uBD84\uC0AC\uC640 AI \uC5F0\uAD6C \uBCF8\uACA9\uD654</b></size>\r\n  2010\uB144
    \uD504\uB85C\uBA54\uC2A4\uB294 \uC778\uACF5\uC9C0\uB2A5 \uC5F0\uAD6C \uC870\uC9C1\uC778
    \uC0AC\uB0B4 \uBCA4\uCC98 IGNIS\uB97C \uC790\uD68C\uC0AC\uB85C \uBD84\uC0AC\uD558\uACE0
    \uB300\uADDC\uBAA8 \uD22C\uC790\uB97C \uC9C4\uD589\uD558\uC600\uB2E4. IGNIS\uB294
    \uC774\uD6C4 \uD504\uB85C\uBA54\uC2A4 AI \uC5F0\uAD6C\uC758 \uD575\uC2EC \uC870\uC9C1\uC73C\uB85C
    \uC131\uC7A5\uD588\uB2E4.\r\n\r\n  2015\uB144 IGNIS\uB294 \uBC14\uB451 \uC778\uACF5\uC9C0\uB2A5
    ProGo\uB97C \uAC1C\uBC1C\uD558\uC600\uB2E4. ProGo\uB294 \uC628\uB77C\uC778 \uB300\uAD6D\uACFC
    \uD504\uB85C \uAE30\uC0AC\uC640\uC758 \uC624\uD504\uB77C\uC778 \uB300\uAD6D\uC744
    \uD569\uC0B0\uD574 \uCD1D 74\uC804 74\uC2B9\uC744 \uAE30\uB85D\uD588\uC73C\uBA70,
    \uC774\uB294 \uC778\uACF5\uC9C0\uB2A5\uC774 \uC778\uAC04\uC758 \uC804\uBB38\uC801
    \uD310\uB2E8 \uC601\uC5ED\uAE4C\uC9C0 \uB300\uCCB4\uD560 \uC218 \uC788\uB2E4\uB294
    \uC778\uC2DD\uC744 \uD655\uC0B0\uC2DC\uD0A8 \uC0AC\uAC74\uC73C\uB85C \uD3C9\uAC00\uB41C\uB2E4.\r\n\r\n\r\n<size=30><b>3.
    AD-001 \uACF5\uAC1C\uC640 \uAD00\uB9AC\uC790\uD615 AI \uC6B4\uC6A9</b></size>\r\n 
    2023\uB144 \uD504\uB85C\uBA54\uC2A4\uB294 AD-001\uC744 \uACF5\uAC1C\uD558\uC600\uB2E4.
    AD-001\uC740 \uC77C\uBC18 \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uC9C1\uC811 \uC11C\uBE44\uC2A4\uB97C
    \uC81C\uACF5\uD558\uB294 AI\uAC00 \uC544\uB2C8\uB77C, \uD504\uB85C\uBA54\uC2A4
    \uACC4\uC5F4 AI \uBAA8\uB378\uC758 \uC6B4\uC6A9 \uC0C1\uD0DC\uB97C \uC810\uAC80\uD558\uACE0
    \uAD00\uB9AC\uD558\uB294 \uC0C1\uC704 \uAD00\uB9AC AI\uC774\uB2E4. \uB300\uC678
    \uD64D\uBCF4\uC5D0\uC11C\uB294 \uD504\uB85C\uBA54\uC2A4 AI \uC11C\uBE44\uC2A4\uC758
    \uB300\uD45C \uC544\uBC14\uD0C0\uB85C \uC0AC\uC6A9\uB418\uBA70, \uB54C\uBB38\uC5D0
    \uC77C\uBC18 \uC774\uC6A9\uC790\uB4E4\uC5D0\uAC8C\uB294 \uD504\uB85C\uBA54\uC2A4\uC758
    \uAC04\uD310 AI\uB85C \uC778\uC2DD\uB418\uC5C8\uB2E4."
