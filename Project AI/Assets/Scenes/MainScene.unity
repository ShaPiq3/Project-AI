  m_text: "  \uD558\uC9C0\uB9CC Plaude\uB294 PGT \uC11C\uBE44\uC2A4\uB97C \uD1B5\uD574
    \uC218\uC9D1\uD55C \uC790\uC5F0\uC5B4 \uB370\uC774\uD130\uB97C \uCF54\uB529\uC5D0
    \uD55C\uC815\uD574 \uB354\uC6B1 \uACE0\uB3C4\uD654\uC2DC\uCF1C \uD504\uB86C\uD504\uD2B8
    \uC774\uD574\uB3C4\uAC00 \uB300\uD3ED \uC0C1\uC2B9, \uC644\uC804 \uC790\uC5F0\uC5B4
    \uAE30\uBC18 \uCF54\uB529\uC774\uB77C\uB294 \uC0C8\uB85C\uC6B4 \uC601\uC5ED\uC744
    \uD0C4\uC0DD\uC2DC\uCF30\uB2E4. \uCF54\uB4DC \uC0DD\uC131 \uAE30\uB2A5\uC740
    \uBB3C\uB860 \uC2E4\uC2DC\uAC04 \uB514\uBC84\uADF8 \uBAA8\uB2C8\uD130\uB9C1,
    \uB2E4\uB978 \uC0AC\uB78C\uC758 \uCF54\uB4DC\uB97C \uBD84\uC11D\uD558\uACE0 \uD574\uB2F9
    \uD615\uC2DD\uC5D0 \uB9DE\uCDB0 \uCF54\uB4DC \uC0DD\uC131/\uC218\uC815 \uB4F1\uC758
    \uB2E4\uC591\uD55C \uAE30\uB2A5\uC744 \uC790\uC5F0\uC5B4\uB85C \uCC98\uB9AC\uD560
    \uC218 \uC788\uC5C8\uB2E4.\r\n"
