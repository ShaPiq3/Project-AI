    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uD504\uB85C\uBA54\uC2A4\uB294 MY\uD14C\uD06C\uB180\uB85C\uC9C0\uAC00
        \uC11C\uBE44\uC2A4\uD558\uB358 \uAC80\uC0C9 \uC5D4\uC9C4\uC758 \uC774\uB984\uC73C\uB85C,
        \uB192\uC740 \uAC80\uC0C9 \uC815\uD655\uB3C4\uC640 \uB2E4\uC591\uD55C \uD3EC\uD138
        \uC5F0\uACC4\uD615 \uC11C\uBE44\uC2A4 (\uAC1C\uC778 \uD648\uD398\uC774\uC9C0,
        \uC778\uD130\uB137 \uC1FC\uD551 \uB4F1)\uB97C \uD0C0 \uD3EC\uD138\uBCF4\uB2E4
        \uC55E\uC11C \uC81C\uACF5\uD558\uC600\uB2E4. \uADF8\uB7EC\uB098 \uC774\uBBF8
        \uC2DC\uC7A5\uC744 \uC120\uC810\uD55C \uACBD\uC7C1 \uC0AC\uC774\uD2B8\uB4E4\uC5D0
        \uBC00\uB824 \uC800\uC870\uD55C \uC774\uC6A9\uB960\uC744 \uBCF4\uC600\uB2E4. "
      objectReference: {fileID: 0}
