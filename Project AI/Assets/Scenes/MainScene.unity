    - target: {fileID: 3268730617973147243, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
      propertyPath: m_text
      value: "\uB3D9\uC544\uB9AC \uAC8C\uC784\uC744 \uB9CC\uB4E4\uBA74\uC11C \uCF54\uB4DC\uAC00
        \uC65C \uC791\uB3D9\uD558\uC9C0 \uC54A\uB294\uC9C0 \uC9C8\uBB38\uD588\uC2B5\uB2C8\uB2E4.
        \uC644\uC131\uB41C \uB2F5\uB9CC \uC8FC\uC9C0 \uC54A\uACE0 \uBCC0\uC218\uC640
        \uD568\uC218\uC758 \uC6D0\uB9AC\uB97C \uC81C \uC218\uC900\uC5D0 \uB9DE\uCDB0
        \uC124\uBA85\uD574 \uC918\uC11C \uACF5\uBD80\uC5D0\uB3C4 \uB3C4\uC6C0\uC774
