    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uAE30\uD48D\uC740 \uB9E4\uC6B0 \uACF5\uACA9\uC801\uC774\uACE0 \uBB18\uC218\uB97C
        \uC990\uACA8 \uB450\uB294 \uD638\uC804\uC801\uC778 \uAE30\uD48D\uC744 \uAC00\uC9C0\uACE0
        \uC788\uB2E4. \uC804\uD22C\uB97C \uD1B5\uD574 \uC0C1\uB300\uB97C \uC2EC\uB9AC\uC801\uC73C\uB85C
        \uB3D9\uC694\uCF00 \uD574 \uC2E4\uC218\uB97C \uC720\uB3C4\uD558\uACE0, \uC0C1\uB300\uAC00
        \uC2E4\uC218\uD558\uC790\uB9C8\uC790 \uCC0D\uC5B4\uB204\uB974\uB294 \uAC70\uCE68\uC5C6\uB294
        \uD50C\uB808\uC774\uC2A4\uD0C0\uC77C \uD0D3\uC5D0 \uB300\uC911\uC801\uC73C\uB85C
        \uB9CE\uC740 \uC778\uAE30\uB97C \uAD6C\uAC00\uD588\uB2E4."
      objectReference: {fileID: 0}
