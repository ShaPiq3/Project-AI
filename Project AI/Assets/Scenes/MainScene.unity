    - target: {fileID: 9000444818378908833, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
      propertyPath: m_text
      value: "\uC774\uC6A9\uC790\uAC00 \uBAB0\uB9AC\uB294 \uC2DC\uAC04\uC5D0\uB294
        \uB2F5\uBCC0 \uC18D\uB3C4\uAC00 \uB290\uB824\uC9C0\uAC70\uB098 \uB300\uD654
        \uD69F\uC218 \uC81C\uD55C\uC774 \uAC78\uB838\uC2B5\uB2C8\uB2E4. \uACFC\uC81C
        \uB9C8\uAC10 \uC9C1\uC804\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC5C8\uB358
        \uACBD\uD5D8 \uB54C\uBB38\uC5D0 \uC2E0\uB8B0\uB3C4\uAC00 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
