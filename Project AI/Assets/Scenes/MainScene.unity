    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  Prok\uC740 \uD504\uB85C\uBA54\uC2A4\uC5D0\uC11C \uAE30\uC874\uC5D0
        \uC11C\uBE44\uC2A4\uD558\uB358 \uC778\uACF5\uC9C0\uB2A5\uC778 PGT\uC758 \uC0AC\uC2E4\uC0C1\uC758
        \uD6C4\uC18D \uBAA8\uB378\uC774\uB2E4. Plaude\uAC00 \uC804\uBB38\uC801\uC778
        \uCEF4\uD4E8\uD305 \uBCF4\uC870\uC5D0 \uAC15\uC810\uC744 \uAC00\uC9C0\uACE0
        \uC788\uB2E4\uBA74, Prok\uC740 \uADF8\uBCF4\uB2E4 \uCF54\uB529 \uC131\uB2A5\uC740
        \uB5A8\uC5B4\uC9C0\uC9C0\uB9CC \uC758\uC0AC\uC18C\uD1B5\uC758 \uC790\uC5F0\uC2A4\uB7EC\uC6C0\uACFC
        \uC77C\uC0C1\uC0DD\uD65C \uC5B4\uC2DC\uC2A4\uD134\uC2A4, \uBBF8\uB514\uC5B4
        \uC0DD\uC131 \uB4F1 \uB2E4\uBC29\uBA74\uC5D0\uC11C\uC758 \uC131\uB2A5 \uC6B0\uC704\uB97C
        \uAC00\uC9C0\uACE0 \uC788\uB2E4."
      objectReference: {fileID: 0}
