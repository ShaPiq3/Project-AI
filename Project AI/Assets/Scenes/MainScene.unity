    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uD504\uB85C\uBA54\uC2A4 AI \uAD00\uB9AC \uC2DC\uC2A4\uD15C\uC5D0
        \uC784\uBCA0\uB514\uB4DC\uB418\uC5B4 \uC788\uC73C\uBA70 \u2018AI\uAC00 AI\uB97C
        \uAD00\uB9AC\uD558\uB294 \uCC28\uC138\uB300 \uC6B4\uC601\uCCB4\uC81C\u2019\uB85C\uC11C
        \uD64D\uBCF4\uB418\uC5C8\uB2E4. \uC2A4\uD399, \uAE30\uB2A5 \uB4F1 \uB300\uBD80\uBD84\uC758
        \uC815\uBCF4\uB294 \uC0AC\uB0B4 \uAE30\uBC00\uB85C \uCDE8\uAE09\uB418\uC5B4
        \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uB2E4."
