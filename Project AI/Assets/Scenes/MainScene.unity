    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  PGT \uC2DC\uC808\uC5D0\uB3C4 \uCF54\uB4DC \uC0DD\uC131 \uAE30\uB2A5\uC740
        \uC788\uC5C8\uC9C0\uB9CC \uC790\uC5F0\uC5B4\uB85C \uB41C \uC124\uBA85\uC744
        \uCF54\uB4DC\uB85C \uC62E\uAE30\uB294 \uB370\uB294 \uD55C\uACC4\uAC00 \uC788\uC5C8\uB2E4.
        \uC778\uAC04\uC774 \uB9CC\uB4E0 \uCF54\uB4DC\uC5D0 \uBE44\uD574 \uC5B4\uC0C9\uD558\uAC70\uB098
        \uBE44\uD6A8\uC728\uC801\uC778 \uBC29\uC2DD\uC758 \uCF54\uB4DC\uAC00 \uC0DD\uC131\uB418\uC5B4,
        \uCF54\uB4DC\uAC00 \uC2E4\uD589\uC740 \uB418\uB294\uB370 \uC778\uAC04\uC758
        \uB17C\uB9AC\uB85C\uB294 \uCF54\uB4DC \uAD6C\uC870\uB97C \uD30C\uC545\uD558\uAE30
