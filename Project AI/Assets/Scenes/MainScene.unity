--- !u!114 &2134313675
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2134313671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  AI \uACBD\uB85C \uC548\uB0B4 \uAE30\uB2A5\uC744 \uB048 \uCC44 \uC5EC\uD589\uC744
    \uB5A0\uB0AC\uB358 20\uB300 \uB0A8\uB140\uAC00 \uC2E4\uC885 \uC77C\uC8FC\uC77C
    \uB9CC\uC5D0 \uAC15\uC6D0 \uC0B0\uAC04 \uC9C0\uC5ED\uC5D0\uC11C \uAD6C\uC870\uB410\uB2E4.\r\n\r\n 
    \uC778\uC81C\uACBD\uCC30\uC11C\uC640 \uC778\uC81C\uC18C\uBC29\uC11C\uC5D0 \uB530\uB974\uBA74
    \uC9C0\uB09C 12\uC77C \uC624\uD6C4 4\uC2DC\uCBE4 \uAC15\uC6D0\uB3D9\uBD80\uAD8C
    \uC57C\uC0B0 \uC778\uADFC \uC784\uB3C4\uC5D0\uC11C \uAE40\uBAA8 \uC528(22)\uC640
    \uC774\uBAA8 \uC528(21)\uAC00 \uBC1C\uACAC\uB410\uB2E4. \uB450 \uC0AC\uB78C\uC740
    \uD0C8\uC9C4 \uC99D\uC138\uB97C \uBCF4\uC600\uC73C\uB098 \uC0DD\uBA85\uC5D0\uB294
    \uC9C0\uC7A5\uC774 \uC5C6\uB294 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uB2E4.\r\n\r\n 
    \uB450 \uC0AC\uB78C\uC740 \uC9C0\uB09C 5\uC77C \uC9C0\uC778\uB4E4\uC5D0\uAC8C
    \u201C\uC7A0\uC2DC \uC5EC\uD589\uC744 \uB2E4\uB140\uC624\uACA0\uB2E4\u201D\uACE0
    \uB9D0\uD55C \uB4A4 \uC5F0\uB77D\uC774 \uB04A\uACBC\uB2E4. \uB9C8\uC9C0\uB9C9
    \uBA54\uC2DC\uC9C0\uC5D0\uB294 \u201CAI \uACBD\uB85C \uC548\uB0B4\uB294 \uAEBC\uB480\uB2E4\u201D,
    \u201C\uC9C1\uC811 \uCC3E\uC544\uAC00\uBA74 \uB41C\uB2E4\u201D, \u201C\uAE38\uC774
    \uC0DD\uAC01\uBCF4\uB2E4 \uBCF5\uC7A1\uD558\uB2E4\u201D\uB294 \uB0B4\uC6A9\uC774
    \uB2F4\uAE34 \uAC83\uC73C\uB85C \uC804\uD574\uC84C\uB2E4.\r\n\r\n  \uACBD\uCC30\uC740
    \uD734\uB300\uC804\uD654\uC758 \uB9C8\uC9C0\uB9C9 \uC704\uCE58\uAC12\uACFC \uC778\uADFC
    CCTV, \uCC28\uB7C9 \uC774\uB3D9 \uACBD\uB85C\uB97C \uD1A0\uB300\uB85C \uC218\uC0C9\uC744
    \uBC8C\uC600\uB2E4. \uB450 \uC0AC\uB78C\uC758 \uCC28\uB7C9\uC740 \uBE44\uD3EC\uC7A5\uB3C4\uB85C
    \uAC00\uC7A5\uC790\uB9AC\uC5D0\uC11C \uBC1C\uACAC\uB410\uC73C\uBA70, \uB0B4\uBD80\uC5D0\uC11C\uB294
    \uBC29\uC804\uB41C \uD734\uB300\uC804\uD654\uC640 \uBE48 \uC0DD\uC218\uBCD1,
    \uAC04\uD3B8\uC2DD \uD3EC\uC7A5\uC9C0\uAC00 \uD655\uC778\uB410\uB2E4.\r\n\r\n 
    \uACBD\uCC30\uC740 \uB450 \uC0AC\uB78C\uC774 \uC704\uCE58 \uAE30\uB85D\uC744
    \uB0A8\uAE30\uC9C0 \uC54A\uAE30 \uC704\uD574 AI \uACBD\uB85C \uC548\uB0B4\uC640
    \uBCF4\uD638\uC790 \uACF5\uC720 \uAE30\uB2A5\uC744 \uB048 \uCC44 \uC0B0\uAC04
    \uB3C4\uB85C\uB85C \uC9C4\uC785\uD588\uB2E4\uAC00 \uAE38\uC744 \uC783\uC740 \uAC83\uC73C\uB85C
    \uBCF4\uACE0 \uC788\uB2E4.\r\n\r\n  \uAD6C\uC870 \uC9C1\uD6C4 \uB450 \uC0AC\uB78C\uC740
    \u201C\uCC98\uC74C\uC5D0\uB294 \uAE08\uBC29 \uB098\uAC08 \uC218 \uC788\uC744
    \uC904 \uC54C\uC558\uB2E4\u201D\uACE0 \uB9D0\uD55C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uB2E4.
    \uACBD\uCC30 \uAD00\uACC4\uC790\uB294 \u201C\uB0AF\uC120 \uC9C0\uC5ED\uC5D0\uC11C\uB294
    \uACBD\uB85C \uC548\uB0B4\uC640 \uC704\uCE58 \uACF5\uC720 \uAE30\uB2A5\uC744
    \uC720\uC9C0\uD574\uC57C \uD55C\uB2E4\u201D\uACE0 \uB2F9\uBD80\uD588\uB2E4."
  m_isRightToLeft: 0
