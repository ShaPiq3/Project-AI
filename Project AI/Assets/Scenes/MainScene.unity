    - target: {fileID: 7159570775045525307, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
      propertyPath: m_text
      value: "\uC5C5\uB370\uC774\uD2B8 \uC774\uD6C4 \uAC19\uC740 \uD504\uB86C\uD504\uD2B8\uC5D0\uB3C4
        \uB2F5\uBCC0 \uB9D0\uD22C\uC640 \uBD84\uB7C9\uC774 \uB2EC\uB77C\uC84C\uC2B5\uB2C8\uB2E4.
        \uC5C5\uBB34\uC6A9 \uC591\uC2DD\uC744 \uC77C\uC815\uD558\uAC8C \uC720\uC9C0\uD574\uC57C
        \uD558\uB294\uB370 \uACB0\uACFC\uAC00 \uC608\uACE0 \uC5C6\uC774 \uBC14\uB00C\uC5B4
        \uBD88\uD3B8\uD588\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7159570775045525307, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
