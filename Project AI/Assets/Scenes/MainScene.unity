--- !u!114 &1588505562
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1588505559}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=30><b>1. \uC694\uCCAD \uCC98\uB9AC \uAD00\uB9AC </b></size>\r\n 
    AD-001\uC740 \uD558\uC704 AI \uC5B4\uC2DC\uC2A4\uD134\uD2B8\uAC00 \uC218\uC2E0\uD55C
    \uC0AC\uC6A9\uC790 \uC694\uCCAD\uC758 \uC131\uACA9\uC744 \uBD84\uC11D\uD558\uACE0,
    \uD574\uB2F9 \uC694\uCCAD\uC774 \uCC98\uB9AC \uAC00\uB2A5\uD55C \uBC94\uC704\uC5D0
    \uD3EC\uD568\uB418\uB294\uC9C0 \uD310\uB2E8\uD55C\uB2E4. \uC694\uCCAD\uC758 \uC704\uD5D8\uB3C4,
    \uB370\uC774\uD130 \uC811\uADFC \uD544\uC694\uC131, \uC751\uB2F5 \uAC00\uB2A5\uC131,
    \uC2DC\uC2A4\uD15C \uC815\uCC45 \uC704\uBC18 \uC5EC\uBD80\uB97C \uAC80\uD1A0\uD55C
    \uB4A4 \uD558\uC704 AI\uC5D0\uAC8C \uCC98\uB9AC \uAD8C\uD55C\uC744 \uBD80\uC5EC\uD558\uAC70\uB098
    \uC81C\uD55C\uD55C\uB2E4.\r\n\r\n\r\n<size=30><b>2. \uB370\uC774\uD130 \uC811\uADFC
    \uAD8C\uD55C \uC870\uC815</b></size>\r\n  AD-001\uC740 \uAC01 AI\uAC00 \uC694\uCCAD
    \uC218\uD589 \uACFC\uC815\uC5D0\uC11C \uC811\uADFC\uD560 \uC218 \uC788\uB294
    \uB370\uC774\uD130 \uBC94\uC704\uB97C \uC870\uC815\uD55C\uB2E4. \uC77C\uC815,
    \uBA54\uC77C, \uC704\uCE58 \uAE30\uB85D \uB4F1 \uBBFC\uAC10\uD55C \uC815\uBCF4\uAC00
    \uC0AC\uC6A9\uB420 \uACBD\uC6B0 \uD574\uB2F9 \uC811\uADFC\uC774 \uC815\uB2F9\uD55C
    \uAD8C\uD55C\uC5D0 \uC758\uD55C \uAC83\uC778\uC9C0, \uC678\uBD80 \uACF5\uC720\uAC00
    \uAC00\uB2A5\uD55C \uC815\uBCF4\uC778\uC9C0 \uB4F1\uC744 \uAC80\uD1A0\uD55C\uB2E4.
    \uC774 \uB54C\uBB38\uC5D0 AD-001\uC740 \uD504\uB85C\uBA54\uC2A4 AI \uC2DC\uC2A4\uD15C\uC758
    \uBCF4\uC548 \uBC0F \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638 \uCCB4\uACC4\uC5D0\uC11C
    \uC911\uC694\uD55C \uC704\uCE58\uB97C \uCC28\uC9C0\uD55C\uB2E4.\r\n\r\n\r\n<size=30><b>3.
    \uC0AC\uACE0 \uB85C\uC9C1 \uC810\uAC80</b></size>\r\n  AD-001\uC758 \uB300\uD45C\uC801\uC778
    \uAE30\uB2A5 \uC911 \uD558\uB098\uB294 AI\uC758 \uC0AC\uACE0 \uB85C\uC9C1 \uC810\uAC80\uC774\uB2E4.
    \uC774\uB294 \uD558\uC704 AI\uAC00 \uD2B9\uC815 \uACB0\uB860\uC5D0 \uB3C4\uB2EC\uD558\uAE30\uAE4C\uC9C0\uC758
    \uD310\uB2E8 \uACBD\uB85C\uB97C \uAC80\uD1A0\uD558\uACE0, \uBE44\uC815\uC0C1\uC801\uC778
    \uCD94\uB860, \uC815\uCC45 \uC704\uBC18, \uC751\uB2F5 \uBD88\uC548\uC815\uC131,
    \uC790\uAE30\uBAA8\uC21C \uB4F1\uC744 \uD0D0\uC9C0\uD558\uB294 \uC808\uCC28\uB97C
    \uC758\uBBF8\uD55C\uB2E4.\r\n\r\n\r\n<size=30><b>4. \uC2DC\uC2A4\uD15C \uC548\uC815\uC131
    \uAC80\uD1A0</b></size>\r\n  AD-001\uC740 \uD504\uB85C\uBA54\uC2A4 AI \uC0DD\uD0DC\uACC4\uC758
    \uC548\uC815\uC131\uC744 \uC720\uC9C0\uD558\uAE30 \uC704\uD574 \uAC01 \uC11C\uBE44\uC2A4\uC758
    \uC751\uB2F5 \uD328\uD134\uACFC \uB85C\uADF8\uB97C \uBAA8\uB2C8\uD130\uB9C1\uD55C\uB2E4.
    \uC608\uC678 \uC751\uB2F5, \uBC18\uBCF5 \uC624\uB958, \uBE44\uC815\uC0C1\uC801
    \uAD8C\uD55C \uC694\uCCAD, \uC678\uBD80 \uACF5\uACA9 \uAC00\uB2A5\uC131 \uB4F1\uC774
    \uD0D0\uC9C0\uB420 \uACBD\uC6B0 \uD574\uB2F9 AI\uC758 \uC751\uB2F5\uC744 \uC81C\uD55C\uD558\uAC70\uB098
    \uC0C1\uC704 \uC2DC\uC2A4\uD15C\uC5D0 \uBCF4\uACE0\uD55C\uB2E4.\r\n\r\n  \uD2B9\uD788
    FPT, Lopilot, SoopSeek, Athena \uB4F1 \uD504\uB85C\uBA54\uC2A4\uC758 \uD575\uC2EC
    AI \uC11C\uBE44\uC2A4\uB294 \uBD84\uC57C\uBCC4 \uAE30\uB2A5\uC774 \uB2E4\uB974\uAE30
    \uB54C\uBB38\uC5D0, AD-001\uC740 \uAC01 \uC11C\uBE44\uC2A4\uC758 \uD2B9\uC131\uC5D0
    \uB9DE\uB294 \uC548\uC815\uC131 \uAE30\uC900\uC744 \uAE30\uBC18\uC73C\uB85C \uBAA8\uB378\uBCC4
    \uC810\uAC80\uC744 \uC218\uD589\uD55C\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a928e4c073e46fd47a5fe8c0ae8e75d5, type: 2}
  m_sharedMaterial: {fileID: -5358017098838946083, guid: a928e4c073e46fd47a5fe8c0ae8e75d5, type: 2}
  m_fontSharedMaterials: []
