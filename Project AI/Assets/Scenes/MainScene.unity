    - target: {fileID: 7132025143417814093, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
      propertyPath: m_text
      value: "\uC544\uC8FC \uAC04\uB2E8\uD55C \uD504\uB85C\uADF8\uB7A8\uC744 \uC694\uCCAD\uD588\uB294\uB370
        \uD655\uC7A5\uC131\uACFC \uC720\uC9C0\uBCF4\uC218\uAE4C\uC9C0 \uACE0\uB824\uD55C
        \uBCF5\uC7A1\uD55C \uAD6C\uC870\uB97C \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.
        \uACB0\uACFC\uB294 \uC798 \uC791\uB3D9\uD588\uC9C0\uB9CC \uC791\uC740 \uD504\uB85C\uC81D\uD2B8\uC5D0\uB294
        \uC9C0\uB098\uCE58\uAC8C \uBB34\uAC70\uC6E0\uC2B5\uB2C8\uB2E4. "
      objectReference: {fileID: 0}
