    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uB300\uAD6D \uC774\uC804 \uBC14\uB451\uACC4\uC640 \uC5B8\uB860\uC5D0\uC11C\uB294
        \uB300\uBD80\uBD84 \uC774\uC11D\uC758 \uC2B9\uB9AC\uAC00 \uB420 \uAC83\uC774\uB77C
        \uC608\uCE21\uD588\uC9C0\uB9CC \uACFC\uD559\uACC4\uC5D0\uC11C\uB294 \uC774\uC11D\uC774
        \uC9C8 \uAC83\uC774\uB77C\uB294 \uC608\uCE21\uB3C4 \uB098\uC654\uB2E4. \uC774\uC11D
