--- !u!114 &1535528404
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1535528401}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=30><b>1. \uAC1C\uBC1C \uC5ED\uC0AC</b></size>\r\n  2020\uB144\uB300
    \uCD08\uBC18 \uB300\uD654\uD615 \uC778\uACF5\uC9C0\uB2A5 \uC11C\uBE44\uC2A4\uAC00
    \uB300\uC911\uD654\uB418\uBA74\uC11C AI\uAC00 \uCC98\uB9AC\uD558\uB294 \uC694\uCCAD\uB7C9\uACFC
    \uB370\uC774\uD130 \uC811\uADFC \uBC94\uC704\uAC00 \uAE09\uACA9\uD788 \uD655\uB300\uB418\uC5C8\uB2E4.
    \uD504\uB85C\uBA54\uC2A4\uB294 \uAC1C\uBCC4 AI\uC758 \uC751\uB2F5\uC744 \uC0AC\uD6C4
    \uAC80\uD1A0\uD558\uB294 \uBC29\uC2DD\uB9CC\uC73C\uB85C\uB294 \uC548\uC815\uC131\uACFC
    \uD6A8\uC728\uC131\uC744 \uD655\uBCF4\uD558\uAE30 \uC5B4\uB835\uB2E4\uACE0 \uD310\uB2E8\uD588\uB2E4.\r\n\r\n 
    AD-001\uC740 \uC774 \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAE30 \uC704\uD574
    \uAC1C\uBC1C\uB418\uC5C8\uB2E4. \uAE30\uC874 AI\uAC00 \uC0AC\uC6A9\uC790\uC758
    \uC694\uCCAD\uC5D0 \uC751\uB2F5\uD558\uB294 \uB370 \uCD08\uC810\uC744 \uB9DE\uCD94\uC5C8\uB2E4\uBA74,
    AD-001\uC740 AI\uC758 \uC751\uB2F5 \uACFC\uC815 \uC790\uCCB4\uB97C \uAD00\uB9AC\uD558\uACE0
    \uAC80\uC99D\uD558\uB294 \uB370 \uCD08\uC810\uC744 \uB454\uB2E4. \uC774\uB97C
    \uD1B5\uD574 \uC624\uB958, \uAD8C\uD55C \uCD08\uACFC, \uB370\uC774\uD130 \uC624\uB0A8\uC6A9,
    \uBE44\uC815\uC0C1 \uC751\uB2F5, \uC0AC\uACE0 \uB85C\uC9C1 \uBD88\uC548\uC815\uC744
    \uC0AC\uC804\uC5D0 \uAC10\uC9C0\uD558\uACE0 \uC870\uC815\uD560 \uC218 \uC788\uB2E4\uB294
    \uAC83\uC774 \uD504\uB85C\uBA54\uC2A4\uC758 \uC124\uBA85\uC774\uB2E4.\r\n\r\n\r\n<size=30><b>2.
    \uC6B4\uC6A9 \uD604\uD669</b></size>\r\n  AD-001\uC740 \uACF5\uAC1C \uC774\uD6C4
    \uD504\uB85C\uBA54\uC2A4 AI \uAD00\uB9AC \uC2DC\uC2A4\uD15C\uC758 \uB300\uD45C
    \uBAA8\uB378\uB85C \uC7A5\uAE30\uAC04 \uC6B4\uC6A9\uB418\uC5C8\uB2E4. \uC2E0\uADDC
    \uC5B4\uC2DC\uC2A4\uD134\uD2B8 \uBAA8\uB378\uC774 \uC815\uC2DD \uC11C\uBE44\uC2A4\uC5D0
    \uD22C\uC785\uB418\uAE30 \uC804, AD-001\uC740 \uD574\uB2F9 \uBAA8\uB378\uC758
    \uAE30\uBCF8 \uC751\uB2F5, \uAD8C\uD55C \uCC98\uB9AC, \uC0AC\uACE0 \uB85C\uC9C1,
    \uB370\uC774\uD130 \uC811\uADFC \uBC29\uC2DD \uB4F1\uC744 \uC810\uAC80\uD55C\uB2E4.\r\n\r\n 
    \uC77C\uBC18 \uC0AC\uC6A9\uC790\uAC00 AD-001\uACFC \uC9C1\uC811 \uC0C1\uD638\uC791\uC6A9\uD558\uB294
    \uACBD\uC6B0\uB294 \uC81C\uD55C\uC801\uC774\uC9C0\uB9CC, \uC77C\uBD80 \uC11C\uBE44\uC2A4\uC5D0\uC11C\uB294
    \uCD08\uAE30 \uC124\uC815, \uBAA8\uB378 \uC810\uAC80, \uBCF4\uC548 \uD655\uC778,
    \uAD00\uB9AC\uC790 \uC548\uB0B4 \uACFC\uC815\uC5D0\uC11C AD-001\uC758 \uC544\uBC14\uD0C0\uAC00
    \uD45C\uC2DC\uB41C\uB2E4. \uC774\uB85C \uC778\uD574 AD-001\uC740 \uB0B4\uBD80
    \uC2DC\uC2A4\uD15C\uC5D0 \uC18D\uD55C \uC874\uC7AC\uC774\uBA74\uC11C\uB3C4 \uB300\uC911\uC801\uC73C\uB85C
    \uB192\uC740 \uC778\uC9C0\uB3C4\uB97C \uAC00\uC9C4 AI\uAC00 \uB418\uC5C8\uB2E4.\r\n\r\n 
    \uD604\uC7AC AD-001\uC740 \uD504\uB85C\uBA54\uC2A4\uC758 \uD575\uC2EC \uAD00\uB9AC\uC790\uD615
    AI\uB85C \uACC4\uC18D \uC6B4\uC6A9\uB418\uACE0 \uC788\uB2E4. \uB2E4\uB9CC 2030\uB144\uB300
    \uC911\uBC18 \uC774\uD6C4 \uD504\uB85C\uBA54\uC2A4\uAC00 \uCC28\uC138\uB300 AI
    \uC11C\uBE44\uC2A4 \uB77C\uC778\uC5C5\uC744 \uC608\uACE0\uD558\uBA74\uC11C, AD-001
    \uC774\uD6C4\uC758 \uD6C4\uC18D \uBAA8\uB378\uC774 \uB4F1\uC7A5\uD560 \uAC00\uB2A5\uC131\uB3C4
    \uC5B8\uAE09\uB418\uACE0 \uC788\uB2E4."
  m_isRightToLeft: 0
