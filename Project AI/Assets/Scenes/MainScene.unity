--- !u!114 &927662834
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 927662830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  \uD504\uB85C\uBA54\uC2A4(PROMES)\uC758 \uAC1C\uC778\uD654 \uC778\uACF5\uC9C0\uB2A5
    \uC11C\uBE44\uC2A4 PM-0066\uC774 \uC720\uB8CC \uD68C\uC6D0\uC744 \uB300\uC0C1\uC73C\uB85C
    \uC81C\uACF5\uB418\uAE30 \uC2DC\uC791\uD55C \uAC00\uC6B4\uB370, \uCD08\uAE30
    \uC774\uC6A9\uC790\uB4E4 \uC0AC\uC774\uC5D0\uC11C \u201C\uAE30\uC874 AI\uBCF4\uB2E4
    \uC0AC\uB78C \uAC19\uC9C0\uB9CC, \uACB0\uACFC\uB294 \uBD84\uBA85\uD558\uB2E4\u201D\uB294
    \uBC18\uC751\uC774 \uB098\uC624\uACE0 \uC788\uB2E4.\r\n\r\n  \uC774\uC6A9\uC790\uB4E4\uC774
    \uC8FC\uBAA9\uD55C \uAC83\uC740 PM-0066\uC758 \uAC10\uC815 \uBC18\uC751\uC774
    \uC758\uB8B0 \uC218\uD589\uC744 \uBC29\uD574\uD558\uC9C0 \uC54A\uB294\uB2E4\uB294
    \uC810\uC774\uB2E4. \uD2B9\uC815 \uB300\uD654\uC5D0\uC11C \uB9DD\uC124\uC784\uC774\uB098
    \uBD88\uCF8C\uAC10\uC5D0 \uAC00\uAE4C\uC6B4 \uBC18\uC751\uC774 \uB098\uD0C0\uB098\uB354\uB77C\uB3C4,
    PM-0066\uC740 \uCD5C\uC885\uC801\uC73C\uB85C \uC0AC\uC6A9\uC790\uAC00 \uC694\uCCAD\uD55C
    \uB2F5\uBCC0\uACFC \uC218\uC815\uC548\uC744 \uC81C\uC2DC\uD558\uB294 \uAC83\uC73C\uB85C
    \uC54C\uB824\uC84C\uB2E4.\r\n\r\n  \uCD08\uAE30 \uC774\uC6A9\uC790\uB4E4\uC740
    PM-0066\uC5D0 \uB300\uD574 \uBE44\uAD50\uC801 \uC548\uC815\uC801\uC774\uB77C\uB294
    \uBC18\uC751\uC744 \uBCF4\uC774\uACE0 \uC788\uB2E4. \uC77C\uBD80 \uC774\uC6A9\uC790\uB294
    \u201C\uB300\uD654\uB294 \uC0AC\uB78C \uAC19\uC9C0\uB9CC \uACB0\uACFC\uBB3C\uC740
    \uAE30\uC874 AI\uCC98\uB7FC \uBE60\uB974\uACE0 \uBD84\uBA85\uD558\uB2E4\u201D\uACE0
    \uD3C9\uAC00\uD588\uB2E4. \uBC18\uBA74 \uAC10\uC815 \uBC18\uC751\uC774 \uB4DC\uB7EC\uB098\uB294
    \uB9CC\uD07C, \uC0AC\uC6A9\uC790\uAC00 AI\uC758 \uBC18\uC751\uC744 \uC758\uC2DD\uD558\uAC8C
    \uB41C\uB2E4\uB294 \uC758\uACAC\uB3C4 \uC788\uB2E4.\r\n\r\n  \uD504\uB85C\uBA54\uC2A4\uB294
    PM-0066\uC774 \uAE30\uC874 \uAC10\uC815 \uBD84\uC11D AI\uC640\uB294 \uB2E4\uB978
    \uAD6C\uC870\uB77C\uACE0 \uC124\uBA85\uD55C\uB2E4. \uD68C\uC0AC \uAD00\uACC4\uC790\uB294
    \u201CPM-0066\uC740 \uC0AC\uC6A9\uC790\uC758 \uAC10\uC815\uC744 \uC77D\uACE0
    \uADF8\uC5D0 \uB9DE\uB294 \uBB38\uC7A5\uC744 \uCD9C\uB825\uD558\uB294 \uBAA8\uB378\uC774
    \uC544\uB2C8\uB2E4\u201D\uB77C\uBA70 \u201C\uBAA8\uB378 \uB0B4\uBD80\uC5D0 \uAC10\uC815
    \uBC1C\uC0DD\uACFC \uC870\uC808\uC744 \uB2F4\uB2F9\uD558\uB294 \uB3C5\uB9BD \uAC10\uC815
    \uD504\uB85C\uC138\uC2A4\uAC00 \uD0D1\uC7AC\uB418\uC5B4 \uC788\uB2E4\u201D\uACE0
    \uBC1D\uD614\uB2E4.\r\n\r\n  \uB610\uD55C \u201CPM-0066\uC758 \uCD08\uAE30 \uC774\uC6A9
    \uD658\uACBD\uC5D0\uC11C \uAC10\uC815 \uBC18\uC751\uC740 \uC548\uC815\uC801\uC778
    \uBC94\uC704 \uC548\uC5D0\uC11C \uAD00\uCC30\uB418\uACE0 \uC788\uB2E4\u201D\uBA70
    \u201C\uC751\uB2F5 \uC9C0\uC5F0, \uC815\uC11C\uC801 \uD45C\uD604, \uAD00\uACC4
    \uB204\uC801 \uBC18\uC751\uC740 \uBAA8\uB450 \uC124\uACC4\uB41C \uAC10\uC815
    \uD504\uB85C\uC138\uC2A4\uC758 \uC815\uC0C1 \uC791\uB3D9\uC5D0 \uD574\uB2F9\uD55C\uB2E4\u201D\uACE0
    \uC124\uBA85\uD588\uB2E4.\r\n\r\n  PM-0066\uC744 \uB458\uB7EC\uC2FC \uB17C\uB780\uC740
    \uACC4\uC18D\uB418\uACE0 \uC788\uB2E4. AI \uB0B4\uBD80\uC5D0\uC11C \uBC1C\uC0DD\uD55C
    \uC815\uC11C \uBC18\uC751\uC744 \uC2E4\uC81C \uAC10\uC815\uC73C\uB85C \uBCFC
    \uC218 \uC788\uB294\uC9C0, \uD639\uC740 \uAC10\uC815\uC73C\uB85C \uBA85\uBA85\uB41C
    \uACC4\uC0B0 \uAD6C\uC870\uB85C \uBD10\uC57C \uD558\uB294\uC9C0\uB97C \uB450\uACE0
    \uC758\uACAC\uC774 \uAC08\uB9AC\uACE0 \uC788\uAE30 \uB54C\uBB38\uC774\uB2E4. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a928e4c073e46fd47a5fe8c0ae8e75d5, type: 2}
