    - target: {fileID: 3938079568052065568, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  \uC2EC \uB300\uD45C\uAC00 ProGo \uC1FC\uD06C \uC774\uC804\uBD80\uD130
        \uC9C1\uC811 \uC124\uACC4\uD558\uACE0 \uC788\uC5C8\uB358 \uC2E0\uAC1C\uB150
        \uC778\uACF5\uC2E0\uACBD\uB9DD\uC744 \uD1B5\uD574 \uD601\uC2E0\uC801\uC778
        \uC790\uC5F0\uC5B4 \uCC98\uB9AC \uB2A5\uB825\uC744 \uC120\uBCF4\uC600\uC73C\uBA70,
        \uCD9C\uC2DC \uD6C4 \uC57D 10\uB144\uC774 \uC9C0\uB09C \uD604\uC7AC \uD504\uB85C\uBA54\uC2A4\uC5D0\uC11C
        \uC11C\uBE44\uC2A4\uC911\uC778 Prok\uACFC \uBE44\uAD50\uD588\uC744 \uB54C
        \uC131\uB2A5\uC774\uB098 \uB2A5\uB3D9\uC131\uC758 \uCC28\uC774\uAC00 \uC788\uC744
        \uBFD0 \uADFC\uBCF8\uC801\uC778 \uAE30\uB2A5\uC740 \uD070 \uCC28\uC774\uAC00
        \uC5C6\uC744 \uC815\uB3C4\uB85C \uC2DC\uB300\uB97C \uC55E\uC120 AI\uC600\uB2E4. "
