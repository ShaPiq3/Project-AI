    - target: {fileID: 3838239232410822974, guid: 42971248c8245bf4a9102808c5fc2380, type: 3}
      propertyPath: m_text
      value: "  PGT, Prok\uC774 \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uC790\uC5F0\uC5B4
        \uCC98\uB9AC\uC640 \uC77C\uC0C1\uC0DD\uD65C \uC5B4\uC2DC\uC2A4\uD134\uD2B8,
        \uC0AC\uC9C4/\uC601\uC0C1/\uC0AC\uC6B4\uB4DC \uB4F1 \uBBF8\uB514\uC5B4 \uC0DD\uC131\uC5D0
        \uAC15\uC810\uC774 \uC788\uB2E4\uBA74, Plaude\uB294 \uD2B9\uD788 \uCEF4\uD4E8\uD130
        \uC5B8\uC5B4 \uAE30\uBC18 \uCF54\uB529 \uAE30\uB2A5\uC774 \uB9E4\uC6B0 \uB6F0\uC5B4\uB098\uB2E4. "
