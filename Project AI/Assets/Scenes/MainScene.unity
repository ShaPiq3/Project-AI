    - target: {fileID: 7470003586318617639, guid: 0521b7e616fa8dd4a87a1e784966715f, type: 3}
      propertyPath: m_text
      value: "\uC878\uC5C5 \uB17C\uBB38\uC758 \uBAA9\uCC28\uC640 \uCD08\uC548\uC744
        \uD568\uAED8 \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4. \uC55E\uC5D0\uC11C \uC124\uBA85\uD55C
        \uC5F0\uAD6C \uBAA9\uC801\uC744 \uACC4\uC18D \uAE30\uC5B5\uD558\uBA74\uC11C
        \uBB38\uB2E8\uC744 \uC218\uC815\uD574 \uC918\uC11C \uC2E4\uC81C \uC870\uAD50\uC640
        \uB300\uD654\uD558\uB294 \uB290\uB08C\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
